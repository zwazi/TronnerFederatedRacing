[Unit]
Description=Tronner Racing server script and map mirror
Documentation=https://github.com/zwazi/TronnerRacing
Requires=armagetronad.service
Wants=network-online.target
After=network-online.target armagetronad.service

[Service]
Type=simple
User=armagetron
Group=armagetron
StateDirectory=tronner-racing
RuntimeDirectory=tronner-racing
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 /opt/TronnerRacing/TronnerRacing.py --config /etc/tronner-racing/config.json
ExecReload=/usr/local/sbin/tronner-racing-reload $MAINPID
Restart=always
RestartSec=250ms
Nice=10
CPUWeight=25
IOSchedulingClass=idle
IOWeight=25
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tronner-racing /var/lib/armagetronad /run/tronner-racing
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
