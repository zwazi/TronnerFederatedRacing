+static sg_FederationGhostMap::iterator sg_FederationFindOrCreate(
+    std::string const &identity )
+{
+    sg_FederationGhostMap::iterator found = sg_federationGhosts.find( identity );
+    if ( found != sg_federationGhosts.end() )
+        return found;
+    int limit = sg_federationGhostLimit;
+    if ( limit < 1 || limit > 512 ||
+         static_cast<int>( sg_federationGhosts.size() ) >= limit )
+        return sg_federationGhosts.end();
+    return sg_federationGhosts.insert(
+        std::make_pair( identity, sg_FederationGhost() ) ).first;
+}
+
+static bool sg_FederationApplyMetadata(
+    sg_FederationGhost &ghost,
+    std::string const &displayHex,
+    std::string const &coloredHex,
+    std::string const &authenticatedHex,
+    int red, int green, int blue,
+    double ping )
+{
+    std::string display, colored, authenticated;
+    if ( red < 0 || red > 15 || green < 0 || green > 15 ||
+         blue < 0 || blue > 15 || !std::isfinite( ping ) ||
+         ping < 0 || ping > 30 ||
+         !sg_FederationHexDecode( displayHex, display, 128 ) ||
+         !sg_FederationHexDecode( coloredHex, colored, 256 ) ||
+         !sg_FederationHexDecode( authenticatedHex, authenticated, 128 ) ||
+        display.empty() )
+        return false;
+
+    std::string label = sg_FederationSafeLabel();
+    bool created = !ghost.player;
+    if ( created )
+    {
+        ghost.player = tNEW(ePlayerNetID)();
+        ghost.player->SetFederationGhost( true );
+        sg_federationGhostReferences.Add( ghost.player );
+    }
+    ghost.player->SetFederationLabel( tString( label.c_str() ) );
+    bool sync = created ||
+        ghost.player->r != static_cast<unsigned short>( red ) ||
+        ghost.player->g != static_cast<unsigned short>( green ) ||
+        ghost.player->b != static_cast<unsigned short>( blue ) ||
+        fabs( ghost.player->ping - ping ) > .0005;
+    if ( ghost.player->FederationGlobalID() !=
+         tString( authenticated.c_str() ) )
+    {
+        ghost.player->SetFederationGlobalID(
+            tString( authenticated.c_str() ) );
+        sync = true;
+    }
+    ghost.player->r = static_cast<unsigned short>( red );
+    ghost.player->g = static_cast<unsigned short>( green );
+    ghost.player->b = static_cast<unsigned short>( blue );
+    ghost.player->ping = static_cast<REAL>( ping );
+    std::string expectedPrefix = "[" + label + "] ";
+    std::string coloredPrefix =
+        "0x66ccff[" + label + "] 0xffffff";
+    tString plainColored = tColoredString::RemoveColors(
+        tString( colored.c_str() ) );
+    std::string plain( static_cast<char const *>( plainColored ) );
+    bool alreadyTagged = !plain.empty() &&
+        plain.compare( 0, expectedPrefix.size(), expectedPrefix ) == 0;
+    std::string visible = colored.empty() ? display : colored;
+    if ( alreadyTagged )
+    {
+        // Normalize payloads produced by the previous federation build. The
+        // recipient's WriteSync call now decides whether this peer label is
+        // visible, so the ghost's canonical name must remain untagged.
+        if ( visible.compare( 0, coloredPrefix.size(), coloredPrefix ) == 0 )
+            visible.erase( 0, coloredPrefix.size() );
+        else
+            visible = display;
+    }
+    if ( visible != ghost.visibleName )
+    {
+        ghost.player->SetName( tString( visible.c_str() ) );
+        ghost.visibleName = visible;
+        sync = true;
+    }
+    if ( sync )
+        ghost.player->RequestSync();
+    if ( created )
+        nNetObject::SyncAll();
+    return true;
+}
+
+static void sg_ApplyFederationGhostLine( std::string const &line )
+{
+    std::istringstream input( line );
+    std::string version, action, identity, displayHex, coloredHex, extra;
+    if ( !( input >> version >> action ) ||
+         ( version != "GHOST_V1" && version != "GHOST_V2" ) )
+        return;
+    bool metadataV2 = version == "GHOST_V2";
+
+    if ( action == "CHAT" )
+    {
+        std::string messageHex, message;
+        if ( !( input >> identity >> messageHex ) || ( input >> extra ) ||
+             !sg_FederationValidIdentity( identity ) ||
+             !sg_FederationHexDecode( messageHex, message, 512 ) ||
+             message.empty() )
+            return;
+        sg_FederationGhostMap::iterator found = sg_federationGhosts.find( identity );
+        if ( found != sg_federationGhosts.end() && found->second.player )
+        {
+            found->second.lastSeen = tSysTimeFloat();
+            found->second.player->FederationChat( tString( message.c_str() ) );
+        }
+        return;
+    }
+
+    if ( action == "FLAGS" )
+    {
+        unsigned long long observedNS = 0;
+        int chatting = 0;
+        if ( !( input >> identity >> observedNS >> chatting ) ||
+             ( input >> extra ) ||
+             !sg_FederationValidIdentity( identity ) || observedNS == 0 ||
+             ( chatting != 0 && chatting != 1 ) )
+            return;
+        sg_FederationGhostMap::iterator found =
+            sg_federationGhosts.find( identity );
+        if ( found != sg_federationGhosts.end() && found->second.player &&
+             observedNS > found->second.flagsNS )
+        {
+            found->second.flagsNS = observedNS;
+            found->second.lastSeen = tSysTimeFloat();
+            found->second.player->SetChatting(
+                ePlayerNetID::ChatFlags_Away, chatting != 0 );
+        }
+        return;
+    }
+
+    if ( action == "COLOR" )
+    {
+        unsigned long long observedNS = 0;
+        double red = 0, green = 0, blue = 0;
+        if ( !( input >> identity >> observedNS >> red >> green >> blue ) ||
+             ( input >> extra ) ||
+             !sg_FederationValidIdentity( identity ) || observedNS == 0 ||
+             !std::isfinite( red ) || !std::isfinite( green ) ||
+             !std::isfinite( blue ) || red < 0 || red > 4 || green < 0 ||
+             green > 4 || blue < 0 || blue > 4 )
+            return;
+        sg_FederationGhostMap::iterator found =
+            sg_federationGhosts.find( identity );
+        if ( found != sg_federationGhosts.end() && found->second.player &&
+             observedNS > found->second.colorNS )
+        {
+            sg_FederationGhost &ghost = found->second;
+            bool changed = !ghost.hasEffectiveColor ||
+                fabs( ghost.effectiveRed - red ) > .0005 ||
+                fabs( ghost.effectiveGreen - green ) > .0005 ||
+                fabs( ghost.effectiveBlue - blue ) > .0005;
+            ghost.colorNS = observedNS;
+            ghost.lastSeen = tSysTimeFloat();
+            ghost.effectiveRed = static_cast<REAL>( red );
+            ghost.effectiveGreen = static_cast<REAL>( green );
+            ghost.effectiveBlue = static_cast<REAL>( blue );
+            ghost.hasEffectiveColor = true;
+            gCycle *cycle = dynamic_cast<gCycle *>( ghost.player->Object() );
+            if ( changed && cycle )
+            {
+                ghost.player->ClearObject();
+                ghost.cycleRed = ghost.cycleGreen = ghost.cycleBlue = -1;
+            }
+        }
+        return;
+    }
+
+    int red = 15, green = 15, blue = 15;
+    double ping = 0;
+    unsigned long long observedNS = 0;
+    if ( action == "PRESENCE" )
+    {
+        int connected = 0;
+        std::string authenticatedHex = "-";
+        bool parsed = metadataV2
+            ? static_cast<bool>( input >> identity >> displayHex >> coloredHex >>
+                                 authenticatedHex >> red >> green >> blue >> ping >>
+                                 observedNS >> connected )
+            : static_cast<bool>( input >> identity >> displayHex >> coloredHex >>
+                                 red >> green >> blue >> ping >> observedNS >> connected );
+        if ( !parsed || ( input >> extra ) ||
+             !sg_FederationValidIdentity( identity ) || observedNS == 0 ||
+             ( connected != 0 && connected != 1 ) )
+            return;
+        sg_FederationGhostMap::iterator found = sg_federationGhosts.find( identity );
+        if ( !connected )
+        {
+            if ( found != sg_federationGhosts.end() &&
+                 observedNS > found->second.metadataNS )
+                sg_RemoveFederationGhost( found );
+            return;
+        }
+        found = sg_FederationFindOrCreate( identity );
+        if ( found == sg_federationGhosts.end() ||
+             observedNS <= found->second.metadataNS ||
+             !sg_FederationApplyMetadata(
+                 found->second, displayHex, coloredHex, authenticatedHex,
+                 red, green, blue, ping ) )
+            return;
+        found->second.metadataNS = observedNS;
+        found->second.lastSeen = tSysTimeFloat();
+        return;
+    }
+
+    int alive = 0;
+    double remoteGameTime = 0, x = 0, y = 0, xdir = 0, ydir = 0, speed = 0;
+    std::string authenticatedHex = "-";
+    bool parsed = metadataV2
+        ? static_cast<bool>( input >> identity >> displayHex >> coloredHex >>
+                             authenticatedHex >> red >> green >> blue >> ping >>
+                             observedNS >> remoteGameTime >> x >> y >> xdir >>
+                             ydir >> speed >> alive )
+        : static_cast<bool>( input >> identity >> displayHex >> coloredHex >>
+                             red >> green >> blue >> ping >> observedNS >>
+                             remoteGameTime >> x >> y >> xdir >> ydir >> speed >> alive );
+    if ( action != "STATE" || !parsed || ( input >> extra ) ||
+         !sg_FederationValidIdentity( identity ) || observedNS == 0 ||
+         ( alive != 0 && alive != 1 ) ||
+         !std::isfinite( remoteGameTime ) || !std::isfinite( x ) ||
+         !std::isfinite( y ) || !std::isfinite( xdir ) ||
+         !std::isfinite( ydir ) || !std::isfinite( speed ) ||
+         fabs( x ) > 10000000 || fabs( y ) > 10000000 ||
+         speed < 0 || speed > 1000000 ||
+         ( alive && xdir * xdir + ydir * ydir < EPS ) )
+        return;
+
+    sg_FederationGhostMap::iterator found = sg_FederationFindOrCreate( identity );
+    if ( found == sg_federationGhosts.end() ||
+         observedNS <= found->second.observedNS ||
+         !sg_FederationApplyMetadata(
+             found->second, displayHex, coloredHex, authenticatedHex,
+             red, green, blue, ping ) )
+        return;
+    sg_FederationGhost &ghost = found->second;
+    ghost.observedNS = observedNS;
+    if ( observedNS > ghost.metadataNS )
+        ghost.metadataNS = observedNS;
+    ghost.lastSeen = tSysTimeFloat();
+
+    gCycle *cycle = dynamic_cast<gCycle *>( ghost.player->Object() );
+    // Cycle color is transmitted only in its create message. If color metadata
+    // arrived after creation, replace the visual proxy on the next motion state.
+    if ( cycle && ( ghost.cycleRed != red || ghost.cycleGreen != green ||
+                    ghost.cycleBlue != blue ) )
+    {
+        ghost.player->ClearObject();
+        cycle = 0;
+        ghost.cycleRed = ghost.cycleGreen = ghost.cycleBlue = -1;
+    }
+    if ( !alive )
+    {
+        if ( cycle )
+        {
+            cycle->ApplyFederationDeath( se_GameTime() );
+            ghost.player->ClearObject();
+        }
+        ghost.cycleRed = ghost.cycleGreen = ghost.cycleBlue = -1;
+        ghost.player->RequestSync();
+        return;
+    }
+
+    eGrid *grid = eGrid::CurrentGrid();
+    if ( !sg_currentGame || !grid )
+        return;
+    eCoord position( static_cast<REAL>( x * gArena::SizeMultiplier() ),
+                     static_cast<REAL>( y * gArena::SizeMultiplier() ) );
