+
+unsigned long long sg_AcquireClientZeroAcceleration(int client)
+{
+    if (sn_GetNetState() != nSERVER || client <= 0 || client > MAXCLIENTS ||
+            !sn_Connections[client].socket ||
+            !sg_clientZeroAccelerationFeature.Supported(client))
+        return 0;
+
+    // Only one prediction override can exist per network peer. Replacing an
+    // active lease leaves the already-sent zero in place and invalidates the
+    // old owner; its eventual destructor will then be harmless.
+    bool const wasActive = sg_clientZeroAccelerationLease[client] != 0;
+    bool const oldTakeoffStaged =
+        sg_clientTakeoffPredictionStaged[client];
+    do
+    {
+        ++sg_nextClientZeroAccelerationLease;
+    }
+    while (sg_nextClientZeroAccelerationLease == 0);
+    sg_clientZeroAccelerationLease[client] =
+        sg_nextClientZeroAccelerationLease;
+    sg_clientTakeoffPredictionStaged[client] = false;
+    if (oldTakeoffStaged)
+    {
+        sg_SendClientSpeedMin(client, sg_speedCycleMin);
+        sg_SendClientSpeedDecayBelow(client, 0);
+    }
+    else if (!wasActive)
+        sg_SendClientSpeedDecayBelow(client, 0);
+    return sg_clientZeroAccelerationLease[client];
+}
+
+bool sg_StageClientTakeoffPrediction(
+    int client, unsigned long long lease, REAL takeoffSpeed,
+    REAL speedMultiplier)
+{
+    if (sn_GetNetState() != nSERVER || client <= 0 || client > MAXCLIENTS ||
+            lease == 0 || sg_clientZeroAccelerationLease[client] != lease ||
+            !sn_Connections[client].socket ||
+            !sg_clientMinimumSpeedFeature.Supported(client))
+        return false;
+    if (sg_clientTakeoffPredictionStaged[client])
+        return true;
+
+    REAL baseSpeed = sg_speedCycle * speedMultiplier;
+    REAL minimumRatio = sg_speedCycleMin;
+    if (std::isfinite(takeoffSpeed) && std::isfinite(baseSpeed) &&
+            takeoffSpeed > 0 && baseSpeed > 0)
+    {
+        REAL takeoffRatio = takeoffSpeed / baseSpeed;
+        if (takeoffRatio > minimumRatio)
+            minimumRatio = takeoffRatio;
+    }
+
+    // The client initiated the launch, but a stock client does not know that
+    // this respawn was held. Let its prediction resume at the same takeoff
+    // speed the server will restore after one estimated one-way trip. The
+    // authoritative settings and physics remain unchanged on the server.
+    sg_SendClientSpeedMin(client, minimumRatio);
+    sg_SendClientSpeedDecayBelow(client, sg_speedCycleDecayBelow);
+    sg_clientTakeoffPredictionStaged[client] = true;
+    return true;
+}
+
+void sg_ReleaseClientZeroAcceleration(
+    int client, unsigned long long lease)
+{
+    if (client <= 0 || client > MAXCLIENTS || lease == 0 ||
+            sg_clientZeroAccelerationLease[client] != lease)
+        return;
+
+    sg_clientZeroAccelerationLease[client] = 0;
+    bool const takeoffStaged = sg_clientTakeoffPredictionStaged[client];
+    sg_clientTakeoffPredictionStaged[client] = false;
+    if (sn_GetNetState() == nSERVER && sn_Connections[client].socket)
+    {
+        if (takeoffStaged)
+            sg_SendClientSpeedMin(client, sg_speedCycleMin);
+        c_sdb.GetSetting().SendConfig(true, client);
+    }
+}
+
+void sg_CancelClientZeroAcceleration(int client)
+{
+    if (client <= 0 || client > MAXCLIENTS ||
+            sg_clientZeroAccelerationLease[client] == 0)
+        return;
+
+    // Invalidate the lease before restoring the setting. Any old cycle that
+    // still remembers this lease can no longer release a future replacement.
+    sg_clientZeroAccelerationLease[client] = 0;
+    bool const takeoffStaged = sg_clientTakeoffPredictionStaged[client];
+    sg_clientTakeoffPredictionStaged[client] = false;
+    if (sn_GetNetState() == nSERVER && sn_Connections[client].socket)
+    {
+        if (takeoffStaged)
+            sg_SendClientSpeedMin(client, sg_speedCycleMin);
+        c_sdb.GetSetting().SendConfig(true, client);
+    }
+}
+
+bool sg_ClientZeroAccelerationActive(int client)
+{
+    return client > 0 && client <= MAXCLIENTS &&
+           sg_clientZeroAccelerationLease[client] != 0;
+}
