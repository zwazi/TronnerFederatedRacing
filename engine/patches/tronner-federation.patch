+// Silently kill players who have supplied no input recently. A cycle must also
+// have existed for the full threshold so newly spawned racers always receive
+// a fair chance to move during a final countdown.
+static void KillIdlePlayers_conf(std::istream &s)
+{
+    if ( se_NeedsServer( "KILL_IDLE_PLAYERS", s, false ) )
+    {
+        return;
+    }
+
+    REAL seconds = 0;
+    s >> seconds;
+    if ( seconds <= 0 )
+    {
+        return;
+    }
+
+    for ( int i = se_PlayerNetIDs.Len() - 1; i >= 0; --i )
+    {
+        ePlayerNetID *p = se_PlayerNetIDs(i);
+        gCycle *c = p ? dynamic_cast<gCycle *>(p->Object()) : 0;
+        if ( !p || !p->IsHuman() || !c || !c->Alive() ||
+             p->LastActivity() < seconds ||
+             se_GameTime() - c->SpawnTime() < seconds )
+        {
+            continue;
+        }
+
+        se_playerKilledWriter << p->GetUserName()
+                              << nMachine::GetMachine(p->Owner()).GetIP()
+                              << c->Position().x << c->Position().y
+                              << c->Direction().x << c->Direction().y;
+        se_playerKilledWriter.write();
+        c->Kill("ADMIN_KILL");
+    }
+}
+
