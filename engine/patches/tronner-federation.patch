+// Optional server-owned display prefix for native players.  Keep it out of
+// name_, userName_, authentication, command lookup, and ladderlog identity;
+// only colored display output and the server-to-client wire name are tagged.
+static tString se_federationLocalLabel( "" );
+static tConfItemLine se_federationLocalLabelConf(
+    "FEDERATION_LOCAL_LABEL", se_federationLocalLabel );
+
+static std::string se_FederationSafeLocalLabel()
+{
+    std::string raw( static_cast<char const *>( se_federationLocalLabel ) );
+    std::string safe;
+    for ( std::string::const_iterator character = raw.begin();
+          character != raw.end() && safe.size() < 12; ++character )
+    {
+        if ( (*character >= 'A' && *character <= 'Z') ||
+             (*character >= 'a' && *character <= 'z') ||
+             (*character >= '0' && *character <= '9') ||
+             *character == '_' || *character == '-' )
+            safe.push_back( *character );
+    }
+    return safe;
+}
+
+static void se_CutString( tColoredString & string, int maxLen );
+
+static tColoredString se_FederationTaggedName(
+    tColoredString const &name,
+    std::string const &label )
+{
+    if ( label.empty() )
+        return name;
+
+    // Keep the region tag visually separate while preserving every color
+    // transition supplied by the player. WriteSync provides a plain bounded
+    // fallback for the legacy 0.2.9 protocol that counts color bytes toward
+    // its 16-byte name limit.
+    tColoredString tagged;
+    tagged << "0x66ccff[" << label.c_str() << "] 0xffffff" << name;
+    return tagged;
+}
+
+static tColoredString se_FederationLegacyName( tColoredString const &name )
+{
+    tColoredString tagged( tColoredString::RemoveColorsLoose( name ) );
+    se_CutString( tagged, 16 );
+    return tagged;
+}
