+static bool sg_clientTakeoffPredictionStaged[MAXCLIENTS + 2] = {};
+static unsigned long long sg_nextClientZeroAccelerationLease = 0;
+static nVersionFeature sg_clientZeroAccelerationFeature(8);
+static nVersionFeature sg_clientMinimumSpeedFeature(9);
+
+static void sg_SendClientSpeedDecayBelow(int client, REAL value)
+{
+    REAL const authoritative = sg_speedCycleDecayBelow;
+    sg_speedCycleDecayBelow = value;
+    c_sdb.GetSetting().SendConfig(true, client);
+    sg_speedCycleDecayBelow = authoritative;
+}
+
+static void sg_SendClientSpeedMin(int client, REAL value)
+{
+    REAL const authoritative = sg_speedCycleMin;
+    sg_speedCycleMin = value;
+    c_smin.GetSetting().SendConfig(true, client);
+    sg_speedCycleMin = authoritative;
