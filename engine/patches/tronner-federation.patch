+static void sg_RemoveFederationGhost( sg_FederationGhostMap::iterator ghost )
+{
+    ePlayerNetID *player = ghost->second.player;
+    if ( player )
+    {
+        gCycle *cycle = dynamic_cast<gCycle *>( player->Object() );
+        if ( cycle )
+            cycle->ApplyFederationDeath( se_GameTime() );
+        player->RemoveFromGame();
+        sg_federationGhostReferences.Remove( player );
+    }
+    sg_federationGhosts.erase( ghost );
+}
+
+static void sg_ClearFederationGhosts()
+{
+    while ( !sg_federationGhosts.empty() )
+        sg_RemoveFederationGhost( sg_federationGhosts.begin() );
+    sg_federationGhostReferences.ReleaseAll();
+}
+
+static void sg_CloseFederationImport( bool clearGhosts )
+{
+    if ( sg_federationImportFD >= 0 )
+    {
+        close( sg_federationImportFD );
+        sg_federationImportFD = -1;
+    }
+    if ( !sg_federationBoundPath.empty() )
+    {
+        unlink( sg_federationBoundPath.c_str() );
+        sg_federationBoundPath.clear();
+    }
+    if ( clearGhosts )
+        sg_ClearFederationGhosts();
+}
+
+static bool sg_OpenFederationImport()
+{
+    std::string path( static_cast<char const *>( sg_federationImportSocket ) );
+    if ( path.empty() || path.size() >= sizeof(((sockaddr_un *)0)->sun_path) )
+        return false;
+    if ( sg_federationImportFD >= 0 && path == sg_federationBoundPath )
+        return true;
+    sg_CloseFederationImport( false );
+
+    int fd = socket( AF_UNIX, SOCK_DGRAM, 0 );
+    if ( fd < 0 )
+        return false;
+    int flags = fcntl( fd, F_GETFL, 0 );
+    if ( flags < 0 || fcntl( fd, F_SETFL, flags | O_NONBLOCK ) < 0 )
+    {
+        close( fd );
+        return false;
+    }
+    int descriptorFlags = fcntl( fd, F_GETFD, 0 );
+    if ( descriptorFlags >= 0 )
+        fcntl( fd, F_SETFD, descriptorFlags | FD_CLOEXEC );
+
+    sockaddr_un address;
+    std::memset( &address, 0, sizeof(address) );
+    address.sun_family = AF_UNIX;
+    std::memcpy( address.sun_path, path.c_str(), path.size() + 1 );
+    unlink( path.c_str() );
+    if ( bind( fd, reinterpret_cast<sockaddr *>( &address ), sizeof(address) ) < 0 )
+    {
+        close( fd );
+        return false;
+    }
+    chmod( path.c_str(), 0660 );
+    sg_federationImportFD = fd;
+    sg_federationBoundPath = path;
+    return true;
+}
