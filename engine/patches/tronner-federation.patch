+static void sg_FederationImportPoll()
+{
+    if ( !sg_federationImportEnabled || sn_GetNetState() != nSERVER )
+    {
+        if ( sg_federationImportFD >= 0 || !sg_federationGhosts.empty() )
+            sg_CloseFederationImport( true );
+        return;
+    }
+    if ( !sg_OpenFederationImport() )
+        return;
+
+    for ( int count = 0; count < 256; ++count )
+    {
+        char buffer[4097];
+        ssize_t length = recv( sg_federationImportFD, buffer,
+                               sizeof(buffer) - 1, MSG_DONTWAIT );
+        if ( length < 0 )
+        {
+            if ( errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR )
+                sg_CloseFederationImport( false );
+            break;
+        }
+        if ( length == 0 || length >= static_cast<ssize_t>( sizeof(buffer) ) )
+            continue;
+        buffer[length] = 0;
+        sg_ApplyFederationGhostLine( std::string( buffer, length ) );
+    }
+
+    double timeout = sg_federationGhostTimeout;
+    if ( !std::isfinite( timeout ) || timeout < .5 )
+        timeout = .5;
+    double now = tSysTimeFloat();
+    sg_FederationGhostMap::iterator ghost = sg_federationGhosts.begin();
+    while ( ghost != sg_federationGhosts.end() )
+    {
+        sg_FederationGhostMap::iterator current = ghost++;
+        if ( now - current->second.lastSeen > timeout )
+            sg_RemoveFederationGhost( current );
+    }
+}
