+bool gCycle::HandleStartHoldDestination(const gDestination &destination)
+{
+    if (sn_GetNetState() != nSERVER || !freezeStartHoldTurns_ ||
+            !IsFrozen(se_GameTime()))
+        return false;
+
+    // A client sends turns as destinations. Only an advancing turn counter is
+    // proof of a turn: brake-only destinations can contain a slightly
+    // different direction vector and must never rotate the held cycle.
+    bool turnCountAdvanced = destination.turns != 0 &&
+        static_cast<short>(destination.turns - turns) > 0;
+    if (turnCountAdvanced)
+    {
+        int winding = Grid()->DirectionWinding(destination.direction);
+        ApplyStartHoldDirection(winding, destination.turns);
+
+        // This turn is applied here rather than entering the normal movement
+        // queue. Acknowledge the turn itself so the owner cannot replay it
+        // after launch, but leave the brake packet to the original path.
+        if (destination.messageID > 1 &&
+                (lastStartHoldMessageID_ <= 1 ||
+                 static_cast<short>(destination.messageID -
+                                    lastStartHoldMessageID_) > 0))
+            lastStartHoldMessageID_ = destination.messageID;
+    }
+
+    if (freezeUntilBrake_)
+    {
+        bool down = destination.braking;
+        bool brakeChanged = down != freezeBrakeActionDown_;
+        bool previousDown = freezeBrakeActionDown_;
+        freezeBrakeActionDown_ = down;
+        if (brakeChanged)
+        {
+            if (Player())
+            {
+                se_cycleStartHoldInputWriter << Player()->GetLogName() <<
+                    ReplayToken() << "destination" <<
+                    sg_HighPrecisionRaceTime(se_GameTime()) <<
+                    sg_HighPrecisionRaceTime(destination.gameTime) <<
+                    down << previousDown << destination.messageID <<
+                    pos.x << pos.y << turns << (currentDestination != NULL);
+                se_cycleStartHoldInputWriter.write();
+            }
+            BeginStartHoldRelease();
+        }
+    }
+
+    // Consume the destination here so its frozen turn or starting brake action
+    // is not replayed by the normal movement simulation after release.
+    return true;
+}
+
+static REAL sg_StartHoldPredictionLead(int owner)
+{
+    if (owner <= 0 || owner > MAXCLIENTS ||
+            !sn_Connections[owner].socket)
+        return 0;
+
+    REAL networkLead = sn_Connections[owner].ping.GetPing() * .5;
+    if (!std::isfinite(networkLead) || networkLead < 0)
+        return 0;
+    if (networkLead > .5)
+        networkLead = .5;
+    return networkLead;
+}
+
+void gCycle::BeginStartHoldRelease()
+{
+    freezeUntilBrake_ = false;
+    braking = 0;
+
+    // RESPAWN_PLAYER_HELD is implemented entirely on the server. A stock
+    // client therefore knows only that its speed is zero. Stage its ordinary
+    // prediction settings now, then launch the server after the packet's
+    // estimated one-way travel time. Both sides begin at freezeSpeed_, so the
+    // first post-launch authoritative sync is a confirmation, not a position
+    // correction.
+    bool predictionStaged = sg_StageClientTakeoffPrediction(
+        Owner(), freezeClientZeroAccelerationLease_, freezeSpeed_,
+        SpeedMultiplier());
+    REAL networkLead = predictionStaged ?
+        sg_StartHoldPredictionLead(Owner()) : 0;
+    freezeUntil_ = se_GameTime() + networkLead;
+}
+
+void gCycle::ApplyStartHoldDirection(int winding, unsigned short turnCount)
+{
+    eCoord heldDirection = Grid()->GetDirection(winding);
+    SetWindingNumberWrapped(winding);
