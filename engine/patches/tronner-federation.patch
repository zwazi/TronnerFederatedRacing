+static bool sg_FederationHexDecode( std::string const &encoded,
+                                    std::string &decoded,
+                                    size_t maximumBytes )
+{
+    if ( encoded == "-" )
+    {
+        decoded.clear();
+        return true;
+    }
+    if ( encoded.empty() || encoded.size() % 2 ||
+         encoded.size() > maximumBytes * 2 )
+        return false;
+
+    decoded.clear();
+    decoded.reserve( encoded.size() / 2 );
+    for ( size_t index = 0; index < encoded.size(); index += 2 )
+    {
+        int value = 0;
+        for ( int digit = 0; digit < 2; ++digit )
+        {
+            char character = encoded[index + digit];
+            value *= 16;
+            if ( character >= '0' && character <= '9' )
+                value += character - '0';
+            else if ( character >= 'a' && character <= 'f' )
+                value += character - 'a' + 10;
+            else
+                return false;
+        }
+        if ( value == 0 || value == '\n' || value == '\r' )
+            return false;
+        decoded.push_back( static_cast<char>( value ) );
+    }
+    return true;
+}
+
+static std::string sg_FederationSafeLabel()
+{
+    std::string raw( static_cast<char const *>( sg_federationGhostLabel ) );
+    std::string safe;
+    for ( std::string::const_iterator character = raw.begin();
+          character != raw.end() && safe.size() < 12; ++character )
+    {
+        if ( (*character >= 'A' && *character <= 'Z') ||
+             (*character >= 'a' && *character <= 'z') ||
+             (*character >= '0' && *character <= '9') ||
+             *character == '_' || *character == '-' )
+            safe.push_back( *character );
+    }
+    return safe.empty() ? std::string("REMOTE") : safe;
+}
