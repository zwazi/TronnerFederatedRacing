+static bool sg_FederationValidIdentity( std::string const &identity )
+{
+    if ( identity.empty() || identity.size() > 512 || identity.size() % 2 )
+        return false;
+    for ( std::string::const_iterator character = identity.begin();
+          character != identity.end(); ++character )
+        if ( !( (*character >= '0' && *character <= '9') ||
+                (*character >= 'a' && *character <= 'f') ) )
+            return false;
+    return true;
+}
