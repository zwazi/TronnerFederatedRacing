+// Federation telemetry leaves the game process only through a nonblocking
+// local Unix datagram.  The network/Firebase sidecar is allowed to disappear,
+// stall, or restart without ever delaying the simulation thread.
+static bool se_federationExportEnabled = false;
+static tSettingItem<bool> se_federationExportEnabledConf(
+    "FEDERATION_EXPORT_ENABLED", se_federationExportEnabled );
+static tString se_federationExportSocket(
+    "/run/tronner-federation/engine-export.sock" );
+static tConfItemLine se_federationExportSocketConf(
+    "FEDERATION_EXPORT_SOCKET", se_federationExportSocket );
+
+#ifndef WIN32
+static int se_federationExportFD = -1;
+
+static void se_CloseFederationExportSocket()
+{
+    if ( se_federationExportFD >= 0 )
+    {
+        close( se_federationExportFD );
+        se_federationExportFD = -1;
+    }
+}
+
+static bool se_OpenFederationExportSocket()
+{
+    if ( se_federationExportFD >= 0 )
+        return true;
+
+    int fd = socket( AF_UNIX, SOCK_DGRAM, 0 );
+    if ( fd < 0 )
+        return false;
+
+    int flags = fcntl( fd, F_GETFL, 0 );
+    if ( flags < 0 || fcntl( fd, F_SETFL, flags | O_NONBLOCK ) < 0 )
+    {
+        close( fd );
+        return false;
+    }
+    int descriptorFlags = fcntl( fd, F_GETFD, 0 );
+    if ( descriptorFlags >= 0 )
+        fcntl( fd, F_SETFD, descriptorFlags | FD_CLOEXEC );
+    se_federationExportFD = fd;
+    return true;
+}
+#endif
+
+void ePlayerNetID::FederationExport()
+{
+#ifdef WIN32
+    return;
+#else
+    if ( !se_federationExportEnabled || sn_GetNetState() != nSERVER )
+    {
+        se_CloseFederationExportSocket();
+        return;
+    }
+    if ( !se_OpenFederationExportSocket() )
+        return;
+
+    std::string socketPath(
+        static_cast<char const *>( se_federationExportSocket ) );
+    sockaddr_un address;
+    std::memset( &address, 0, sizeof(address) );
+    if ( socketPath.empty() || socketPath.size() >= sizeof(address.sun_path) )
+        return;
+    address.sun_family = AF_UNIX;
+    std::memcpy( address.sun_path, socketPath.c_str(), socketPath.size() + 1 );
+
+    for ( int index = se_PlayerNetIDs.Len() - 1; index >= 0; --index )
+    {
+        ePlayerNetID * player = se_PlayerNetIDs(index);
+        if ( !player || !player->IsHuman() )
+            continue;
+
+        gCycle * cycle = dynamic_cast<gCycle *>( player->Object() );
+        bool alive = cycle && cycle->Alive();
+        eCoord position( 0, 0 );
+        eCoord direction( 0, 0 );
+        REAL speed = 0;
+        gRealColor cycleColor;
+        if ( cycle )
+            cycleColor = cycle->color_;
+        if ( alive )
+        {
+            position = cycle->MapPosition();
+            direction = cycle->Direction();
+            speed = cycle->Speed();
+        }
+
+        std::ostringstream message;
+        message.precision( std::numeric_limits<REAL>::max_digits10 );
+        message << "CYCLE_V1 " << player->GetLogName() << ' '
+                << se_GameTime() << ' '
+                << position.x << ' ' << position.y << ' '
+                << direction.x << ' ' << direction.y << ' '
+                << speed << ' ' << player->ping << ' '
+                << ( alive ? 1 : 0 ) << ' '
+                << ( player->IsChatting() ? 1 : 0 ) << ' '
+                << cycleColor.r << ' ' << cycleColor.g << ' '
+                << cycleColor.b;
+        std::string payload = message.str();
+        sendto(
+            se_federationExportFD,
+            payload.data(),
+            payload.size(),
+            MSG_DONTWAIT,
+            reinterpret_cast<sockaddr *>( &address ),
+            sizeof(address)
+        );
+    }
+#endif
+}
