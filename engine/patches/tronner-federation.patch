+static void se_FederationDisplayServerTagsConf( std::istream &s )
+{
+    if ( se_NeedsServer( "FEDERATION_DISPLAY_SERVER_TAGS", s, false ) )
+        return;
+
+    ePlayerNetID *viewer = ReadPlayer( s );
+    int enabled = -1;
+    s >> enabled;
+    if ( !viewer || !viewer->IsHuman() || viewer->Owner() <= 0 ||
+         ( enabled != 0 && enabled != 1 ) )
+    {
+        con << "Usage: FEDERATION_DISPLAY_SERVER_TAGS <player> <0|1>\n";
+        return;
+    }
+
+    int viewerUser = viewer->Owner();
+    for ( int i = se_PlayerNetIDs.Len() - 1; i >= 0; --i )
+    {
+        ePlayerNetID *localPlayer = se_PlayerNetIDs(i);
+        if ( localPlayer && localPlayer->IsHuman() &&
+             localPlayer->Owner() == viewerUser )
+            localPlayer->SetDisplayServerTags( enabled != 0 );
+    }
+
+    // Only the toggling client needs new player-name syncs. WriteSync formats
+    // each local and federated player name specifically for this recipient.
+    for ( int i = se_PlayerNetIDs.Len() - 1; i >= 0; --i )
+    {
+        ePlayerNetID *visiblePlayer = se_PlayerNetIDs(i);
+        if ( visiblePlayer )
+            visiblePlayer->RequestSync( viewerUser, true );
+    }
+}
